{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "waveform-component": ["./src/index.ts"]
    }
  },
  "include": [
    "src",
    "playground",
    "vite.config.ts",
    "vite.lib.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts"
  ],
  "exclude": ["node_modules", "dist", "dist-playground", "coverage"]
}
