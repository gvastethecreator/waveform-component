{
  "name": "waveform-component",
  "version": "0.1.0",
  "description": "A headless-first, deeply customizable audio waveform component and Signal Workbench.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite --port 3000 --host localhost",
    "clean": "tsx scripts/clean.ts",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:playground": "vite build",
    "build": "pnpm run clean && pnpm run build:lib && pnpm run build:types && pnpm run build:playground",
    "preview": "vite preview --outDir dist-playground --host localhost",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc -p fixtures/external-consumer/tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt . --ignore-path .prettierignore",
    "format:check": "oxfmt --check . --ignore-path .prettierignore",
    "test": "vitest run src playground",
    "test:watch": "vitest src playground",
    "test:coverage": "vitest run src playground --coverage",
    "test:ssr-import": "node --input-type=module -e \"await import('./dist/index.js')\"",
    "test:consumer": "tsx scripts/clean-consumer.ts && pnpm pack --out fixtures/external-consumer/waveform-component.tgz && pnpm --dir fixtures/external-consumer install --ignore-workspace --no-frozen-lockfile --ignore-scripts && pnpm run typecheck:consumer",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "deps:check": "pnpm outdated",
    "audit": "pnpm audit --audit-level high",
    "verify:tracer": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build && pnpm run test:ssr-import && pnpm run test:consumer",
    "verify": "pnpm run verify:tracer"
  },
  "devDependencies": {
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "playwright": "1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}
